<?xml version="1.0"?>
<ruleset name="Trouble Ticket Connector">
	<description>WordPress coding standards for the connector runtime.</description>
	<file>trouble-ticket-connector.php</file>
	<file>uninstall.php</file>
	<file>inc</file>
	<exclude-pattern>tests/*</exclude-pattern>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_trouble_ticket_connector"/>
			</property>
		</properties>
	</rule>
</ruleset>
